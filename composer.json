{
    "name": "edrard/wggetter",
    "description": "Parallel raw HTTP GET fetcher with per-URL retries for PHP 8.5",
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "guzzlehttp/guzzle": "^7.10",
        "guzzlehttp/psr7": "^2.11",
        "psr/log": "^3.0",
        "ext-ctype": "*"
    },
    "autoload": {
        "psr-4": {
            "edrard\\WgGetter\\": "src/WgGetter/"
        }
    },
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Edrard"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload-dev": {
        "psr-4": {
            "edrard\\Tests\\WgDataGetter\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        }
    },
    "homepage": "https://github.com/Edrard/WgDataGetter",
    "support": {
        "source": "https://github.com/Edrard/WgDataGetter",
        "issues": "https://github.com/Edrard/WgDataGetter/issues"
    }
}
